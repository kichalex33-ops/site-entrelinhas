{
  "name": "entrelinhas",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entrelinhas-db",
      "database_id": "834af0a0-9517-4909-b9cb-7054c1ed1a42",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "entrelinhas.sinalruido.com.br", "custom_domain": true }]
}
