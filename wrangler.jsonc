{
  "name": "entrelinhas",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "TURNSTILE_SITEKEY": "0x4AAAAAAFMNJfStOwu_LM0f", "ESTUDIO_PUBLICACAO": "on", "DISQUS_SHORTNAME": "entrelinhas-1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entrelinhas-db",
      "database_id": "a735e336-72de-411f-9771-e6ca5af20b76",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "entrelinhasbr.com.br", "custom_domain": true },
    { "pattern": "www.entrelinhasbr.com.br", "custom_domain": true }
  ]
}
