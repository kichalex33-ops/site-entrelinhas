{
  "name": "entrelinhas",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // PUBLIC_LAUNCH: "off" no beta (todas as paginas saem noindex e o robots.txt nao anuncia o sitemap).
  // Mudar para "on" so depois do beta com usuarios reais: libera a indexacao das paginas publicas (src/meta.js).
  "vars": { "TURNSTILE_SITEKEY": "0x4AAAAAAFMNJfStOwu_LM0f", "ESTUDIO_PUBLICACAO": "on", "DISQUS_SHORTNAME": "entrelinhas-1", "PUBLIC_LAUNCH": "off" },
  // limite geral de escritas por sessao/IP (src/index.js: excedeuEscritas). 120 por minuto: o autosave do Estudio
  // faz no maximo ~40 por minuto digitando sem parar; um script abusivo para aqui.
  "ratelimits": [{ "name": "ESCRITAS", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "triggers": { "crons": ["0 6 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entrelinhas-db",
      "database_id": "a735e336-72de-411f-9771-e6ca5af20b76",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "entrelinhasbr.com.br", "custom_domain": true },
    { "pattern": "www.entrelinhasbr.com.br", "custom_domain": true }
  ]
}
