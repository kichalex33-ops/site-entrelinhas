{
  "name": "entrelinhas-site",
  "private": true,
  "type": "module",
  "description": "Site Entrelinhas (Cloudflare Worker + D1). Este package.json e so de desenvolvimento: o deploy continua sem build.",
  "scripts": {
    "test": "node --no-warnings --test \"tools/tests/*.test.mjs\"",
